---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects, type Project } from '../../data/portfolio';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

type Props = { project: Project };
const { project } = Astro.props;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length];
const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.summary,
  creator: { '@type': 'Person', name: 'Dunhill Dimaapi' },
  url: project.url,
  keywords: project.technologies.join(', '),
};
---

<BaseLayout
  title={`${project.title} — Case Study | Dunhill Dimaapi`}
  description={`${project.summary} Role: ${project.role}.`}
  type="article"
  structuredData={projectSchema}
>
  <article class="case-study">
    <header class="case-hero section-dark">
      <div class="shell">
        <a class="back-link" href="/#work">← Back to selected work</a>
        <div class="case-title-grid">
          <div>
            <p class="eyebrow">{project.category}</p>
            <h1>{project.title}</h1>
          </div>
          <p>{project.summary}</p>
        </div>
        <dl class="case-facts">
          <div><dt>Role</dt><dd>{project.role}</dd></div>
          <div><dt>Client</dt><dd>{project.client}</dd></div>
          <div><dt>Focus</dt><dd>{project.technologies.slice(0, 3).join(' · ')}</dd></div>
          <div><dt>Status</dt><dd>{project.url ? 'Public project' : 'Private engagement'}</dd></div>
        </dl>
      </div>
    </header>

    <div class="shell case-cover">
      <Image
        src={project.cover}
        alt={`${project.title} product interface`}
        widths={[720, 1080, 1440]}
        sizes="(min-width: 1200px) 1120px, 94vw"
        format="webp"
        loading="eager"
      />
    </div>

    <section class="section case-overview">
      <div class="shell case-content-grid">
        <div>
          <p class="eyebrow">Overview</p>
          <h2>Engineering for the whole product experience.</h2>
        </div>
        <div class="case-prose">
          <p class="large-copy">{project.overview}</p>
          {project.url && (
            <a class="button button-dark" href={project.url} target="_blank" rel="noreferrer">
              {project.linkLabel ?? 'Visit live project'} <span aria-hidden="true">↗</span>
            </a>
          )}
        </div>
      </div>
    </section>

    <section class="section section-tint">
      <div class="shell case-content-grid">
        <div>
          <p class="eyebrow">Contribution</p>
          <h2>What I handled.</h2>
        </div>
        <ol class="contribution-list">
          {project.contribution.map((item, index) => (
            <li><span>0{index + 1}</span><p>{item}</p></li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section gallery-section" aria-labelledby="gallery-title">
      <div class="shell">
        <div class="section-heading split-heading">
          <div><p class="eyebrow">Interface</p><h2 id="gallery-title">A closer look.</h2></div>
          <ul class="tag-list tag-list-large" aria-label="Project technologies">
            {project.technologies.map((technology) => <li>{technology}</li>)}
          </ul>
        </div>
        <div class="case-gallery">
          {project.gallery.map((image, index) => (
            <Image
              src={image}
              alt={`${project.title} interface view ${index + 1}`}
              widths={[480, 800, 1200]}
              sizes="(min-width: 800px) 50vw, 100vw"
              format="webp"
              loading="lazy"
            />
          ))}
        </div>
      </div>
    </section>

    <section class="next-project section-dark">
      <div class="shell">
        <p class="eyebrow">Next case study</p>
        <ProjectCard project={nextProject} featured index={(currentIndex + 1) % projects.length} />
      </div>
    </section>
  </article>
</BaseLayout>
