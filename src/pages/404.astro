---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Dunhill Dimaapi" description="The requested portfolio page could not be found.">
  <section class="error-page section-dark">
    <div class="shell">
      <p class="eyebrow">404</p>
      <h1>This route needs a better endpoint.</h1>
      <p>The page may have moved during the portfolio rebuild.</p>
      <a class="button button-accent" href="/">Return home</a>
    </div>
  </section>
</BaseLayout>
