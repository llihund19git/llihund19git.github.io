---
import '../styles/global.css';
import favicon from '../../assets/img/favicon.png';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

type Props = {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  structuredData?: Record<string, unknown>;
};

const {
  title = 'Dunhill Dimaapi — Senior Full-Stack Developer',
  description = 'Portfolio of Dunhill Dimaapi, a senior full-stack developer building secure banking services, web platforms, mobile applications, APIs, and cloud-supported systems.',
  image = '/og.png',
  type = 'website',
  structuredData,
} = Astro.props;

const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const socialImage = Astro.site ? new URL(image, Astro.site) : new URL(image, Astro.url);
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Dunhill Dimaapi',
  jobTitle: 'Senior Full-Stack Developer',
  url: Astro.site?.toString(),
  sameAs: [
    'https://github.com/llihund19git',
    'https://www.linkedin.com/in/llihund19/',
  ],
  knowsAbout: ['Laravel', 'PHP', 'React', 'React Native', 'Node.js', 'Redis', 'AWS', 'Azure DevOps', 'API development', 'secure software delivery'],
};
const schema = structuredData ? [personSchema, structuredData] : personSchema;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d1b2a" />
    <meta name="description" content={description} />
    <meta name="author" content="Dunhill Dimaapi" />
    <meta name="generator" content={Astro.generator} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={favicon.src} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:site_name" content="Dunhill Dimaapi" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <title>{title}</title>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <script>
      const mobileMenu = document.querySelector('[data-mobile-menu]');
      mobileMenu?.querySelectorAll('a').forEach((link) => {
        link.addEventListener('click', () => mobileMenu.removeAttribute('open'));
      });
    </script>
  </body>
</html>
