---
const home = Astro.url.pathname === '/';
const link = (hash: string) => home ? hash : `/${hash}`;
---

<header class="site-header">
  <div class="shell header-inner">
    <a class="brand" href="/" aria-label="Dunhill Dimaapi, home">
      <span class="brand-mark" aria-hidden="true">DD</span>
      <span class="brand-copy">
        <strong>Dunhill Dimaapi</strong>
        <small>Senior Full-Stack Developer</small>
      </span>
    </a>

    <nav class="desktop-nav" aria-label="Primary navigation">
      <a href={link('#work')}>Work</a>
      <a href={link('#experience')}>Experience</a>
      <a href={link('#capabilities')}>Capabilities</a>
      <a href={link('#about')}>About</a>
      <a href={link('#leadership')}>Leadership</a>
      <a class="nav-cta" href={link('#contact')}>Let’s talk</a>
    </nav>

    <details class="mobile-menu" data-mobile-menu>
      <summary>Menu</summary>
      <nav aria-label="Mobile navigation">
        <a href={link('#work')}>Work</a>
        <a href={link('#experience')}>Experience</a>
        <a href={link('#capabilities')}>Capabilities</a>
        <a href={link('#about')}>About</a>
        <a href={link('#leadership')}>Leadership</a>
        <a href={link('#contact')}>Let’s talk</a>
      </nav>
    </details>
  </div>
</header>
